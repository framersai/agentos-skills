{
  "name": "@framers/agentos-skills",
  "version": "1.0.0",
  "description": "Curated SKILL.md prompt modules for AgentOS with a machine-readable registry index",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./registry.json",
    "./registry.json": "./registry.json",
    "./types": "./types.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "registry",
    "registry.json",
    "types.d.ts",
    "scripts",
    "CONTRIBUTING.md",
    "README.md"
  ],
  "scripts": {
    "validate": "node scripts/validate-skill.mjs",
    "update:registry": "node scripts/update-registry.mjs",
    "typecheck": "echo 'agentos-skills: content-only package, no TypeScript to check'",
    "build": "echo 'agentos-skills: content-only package, no build step'"
  },
  "keywords": [
    "agentos",
    "skills",
    "prompts",
    "skill-modules",
    "ai-agent",
    "prompt-engineering",
    "curated-catalog"
  ],
  "author": {
    "name": "Framers AI",
    "email": "team@frame.dev",
    "url": "https://frame.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/framersai/agentos-skills.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
