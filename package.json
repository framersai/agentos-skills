{
  "name": "@framers/agentos-skills",
  "version": "0.3.0",
  "description": "Skills engine for AgentOS — parser, loader, and SkillRegistry runtime for SKILL.md prompt modules",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "agentos",
    "skills",
    "runtime",
    "skill-loader",
    "skill-registry",
    "prompts"
  ],
  "author": {
    "name": "Framers AI",
    "email": "team@frame.dev",
    "url": "https://frame.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/framersai/agentos-skills.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "@framers/agentos": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@framers/agentos": {
      "optional": true
    }
  }
}
